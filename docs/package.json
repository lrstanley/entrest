    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.16.2",
    "fumapress": "1.6.2",
    "lucide-react": "^1.47.0",
    "pele": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
